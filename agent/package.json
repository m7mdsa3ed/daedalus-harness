{
  "name": "daedalus-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "daedalus-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm openui:check && pnpm test:instructions && pnpm test:model-prompts && pnpm test:handshake && pnpm test:turn && pnpm test:metering && pnpm test:trace && pnpm test:tools && pnpm test:tool-search && pnpm test:mcp-prompts && pnpm test:mcp-features && pnpm test:persistence && pnpm test:title && pnpm test:subagents && pnpm test:fixes && pnpm test:resilience",
    "test:model-prompts": "tsx test/model-prompts.test.ts",
    "test:fixes": "tsx test/fixes.test.ts",
    "test:resilience": "tsx test/tool-resilience.test.ts",
    "test:instructions": "tsx test/instructions.test.ts",
    "test:handshake": "tsx test/handshake.test.ts",
    "test:turn": "tsx test/turn.test.ts",
    "test:metering": "tsx test/metering.test.ts",
    "test:trace": "tsx test/trace.test.ts",
    "test:tools": "tsx test/tools.test.ts",
    "test:tool-search": "tsx test/tool-search.test.ts",
    "test:mcp-prompts": "tsx test/mcp-prompts.test.ts",
    "test:mcp-features": "tsx test/mcp-features.test.ts",
    "test:persistence": "tsx test/persistence.test.ts",
    "test:title": "tsx test/title.test.ts",
    "test:subagents": "tsx test/subagents.test.ts",
    "openui:check": "pnpm --dir ../client openui:check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@ai-sdk/provider": "^4.0.33",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.152",
    "gpt-tokenizer": "^4.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  }
}
