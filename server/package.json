{
  "name": "daedalus-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/index.js",
    "pm2:start": "pnpm build && pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop daedalus-server",
    "pm2:logs": "pm2 logs daedalus-server",
    "start": "tsx src/index.ts",
    "test": "pnpm test:bridge && pnpm test:history && pnpm test:fs && pnpm test:websearch && pnpm test:models && pnpm test:ide && pnpm test:registry",
    "test:bridge": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-data tsx test/bridge.test.ts",
    "test:history": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-history tsx test/workspace-history.test.ts",
    "test:fs": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-fs tsx test/workspace-fs.test.ts",
    "test:websearch": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-websearch tsx test/websearch.test.ts",
    "test:models": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-models tsx test/models.test.ts",
    "test:ide": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-ide tsx test/ide.test.ts",
    "test:registry": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-registry tsx test/registry.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.82",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.4",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ]
  }
}
