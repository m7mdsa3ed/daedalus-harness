{
  "name": "daedalus-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/index.js",
    "build:agent": "pnpm --dir ../agent install && pnpm --dir ../agent build",
    "pm2:start": "pnpm build && pnpm build:agent && pnpm db:push && pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop daedalus-server",
    "pm2:logs": "pm2 logs daedalus-server",
    "start": "tsx src/index.ts",
    "test": "pnpm test:bridge && pnpm test:fs && pnpm test:websearch && pnpm test:models && pnpm test:ide && pnpm test:registry && pnpm test:gateway && pnpm test:backup && pnpm test:boards && pnpm test:search && pnpm test:session-journal && pnpm test:acp-units && pnpm test:workflow-schema && pnpm test:workflow && pnpm test:autonomy && pnpm test:scheduler && pnpm test:git-trigger && pnpm test:routines && pnpm test:quota",
    "test:autonomy": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-autonomy tsx test/autonomy.test.ts",
    "test:scheduler": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-scheduler tsx test/scheduler.test.ts",
    "test:git-trigger": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-git-trigger tsx test/routine-git-trigger.test.ts",
    "test:session-journal": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-session-journal tsx test/session-journal.test.ts",
    "test:acp-units": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-acp-units tsx test/acp-bridge-units.test.ts",
    "test:quota": "tsx test/quota.test.ts",
    "test:workflow-schema": "tsx test/workflow-schema.test.ts",
    "test:workflow": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-workflow tsx test/workflow.test.ts",
    "test:search": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-search tsx test/search.test.ts",
    "test:gateway": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-gateway tsx test/gateway-shim.test.ts",
    "test:bridge": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-data tsx test/bridge.test.ts",
    "test:fs": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-fs tsx test/workspace-fs.test.ts",
    "test:websearch": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-websearch tsx test/websearch.test.ts",
    "test:models": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-models tsx test/models.test.ts",
    "test:ide": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-ide tsx test/ide.test.ts",
    "test:registry": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-registry tsx test/registry.test.ts",
    "test:backup": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-backup tsx test/backup.test.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:boards": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-boards tsx test/boards.test.ts",
    "test:routines": "DAEDALUS_DATA_DIR=/tmp/daedalus-test-routines tsx test/routines.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.82",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.4",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty"
    ]
  }
}
