{
  "name": "daedalus-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "node scripts/dev-tunnel.mjs",
    "dev:serve": "node scripts/dev-serve.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "sh -c 'vite & VITE=$!; trap \"kill $VITE\" EXIT; ELECTRON_DEV_URL=http://localhost:5173 electron .'",
    "electron:start": "pnpm build && electron .",
    "electron:dist": "pnpm build && node scripts/electron-dist.mjs",
    "electron:dist:win": "pnpm build && node scripts/electron-dist.mjs --win",
    "icons": "node scripts/render-icons.mjs",
    "test": "tsc -b && pnpm test:subagents",
    "test:subagents": "pnpm exec tsx src/lib/tools/subagents.check.mjs",
    "openui": "node scripts/gen-openui.mjs",
    "openui:check": "node scripts/gen-openui.mjs --check"
  },
  "build": {
    "appId": "com.daedalus.harness",
    "productName": "Daedalus",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/openai": "4.0.83",
    "@ai-sdk/react": "4.0.130",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@openuidev/react-lang": "1.1.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-sync-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "ai": "7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dockview-react": "^8.3.1",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.0.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.12.0",
    "input-otp": "^1.5.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.56.0",
    "motion": "^14.3.0",
    "pptx-preview": "^1.0.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
