{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    /* Off on purpose: shadcn ships components with an unused `import * as
       React` (jsx: react-jsx needs none), and `components/ui/` is meant to be
       re-installable rather than hand-edited — see the shadcn note in
       CLAUDE.md. Trading unused-local detection for a `shadcn add` that
       typechecks without a follow-up edit in every file it wrote. */
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      /* The thread protocol is defined once, on the server that speaks it.
         Every import of it is type-only, so `verbatimModuleSyntax` erases the
         statement and Vite never resolves this path at build time. */
      "@daedalus/protocol": ["../server/src/protocol.ts"],
      "@daedalus/delivery": ["../server/src/delivery.ts"],
      /* The ACP vocabulary the protocol is written in, through the server's
         one barrel over the SDK (server/src/acp.ts) — so the vendor package is
         named in one place per half. Type-only for the same reason as above. */
      "@daedalus/acp": ["../server/src/acp.ts"]
    }
  },
  "include": ["src"]
}
